# Copy to .env. The app loads this file on startup.
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional real email delivery. Without these, the briefing is pushed to the in-app inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Server settings
APP_TIMEZONE=Asia/Shanghai
APP_DATA_DIR=./data

